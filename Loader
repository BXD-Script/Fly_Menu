speedBox.FocusLost:Connect(function(enterPressed)
local textVal = speedBox.Text:gsub("%s+", "")
if textVal == "" then
level = 1
else
local num = tonumber(textVal)
if num then
if num < 1 then num = 1 end
if num > 9000000000 then num = 9000000000 end
level = math.floor(num)
else
level = 1
end
end
flySpeed = getSpeedFromLevel(level)
speedBox.Text = tostring(level)
end)

